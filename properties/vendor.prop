# Audio — Core AAUDIO/Framework
aaudio.hw_burst_min_usec=2000
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
ro.audio.flinger_standbytime_ms=2000
ro.audio.stereo_spatialization_enabled=true
ro.audio.monitorRotation=true
ro.audio.spatializer_enabled=true

# Audio — MiSound / SFX
persist.vendor.audio.misound.disable=true
ro.vendor.audio.soundfx.type=mi
ro.vendor.audio.soundfx.usb=true
ro.vendor.audio.sfx.earadj=true
ro.vendor.audio.sfx.scenario=true
ro.vendor.audio.fweffect=true
ro.vendor.audio.ear.scan.support=true

# Audio — Feature Flags (from stock 301 ODM build.prop)
ro.vendor.audio.aiasst.support=true
ro.vendor.audio.btsamplerate.adaptive=true
ro.vendor.audio.dualadc.support=true
ro.vendor.audio.extendtonecallendedlength=true
ro.vendor.audio.feature.fade=true
ro.vendor.audio.feature.spatial=5
ro.vendor.audio.gain.support=true
ro.vendor.audio.multi.channel=true
ro.vendor.audio.multichannel.5point1=false
ro.vendor.audio.multichannel.5point1.headset=true
ro.vendor.audio.multiroute=true
ro.vendor.audio.notification.single=true
ro.vendor.audio.remotesubmix.support_multichannel=true
ro.vendor.audio.sos=true
ro.vendor.audio.spk.stereo=true
ro.vendor.audio.support.sound.id=true
ro.vendor.audio.surround.headphone.only=true
ro.vendor.audio.videobox.switch=true

# Audio — VoIP / Voice / Meeting (RE: libaudiocorehal.qti.so)
# volume.boost.support=5 → enables updateVoipVolumeBoost() with 5 boost levels
# meeting.mode=true → enables MiMeetingQcom (CSS, VPNR, focus mode, rotation)
# meeting.mode.type=2 → full Qcom MiMeetingQcom implementation
# call.tx.ns=true → TX noise suppression during voice calls
# algorithm.support=Fluence → Qualcomm Fluence noise reduction
ro.vendor.audio.volume.boost.support=5
ro.vendor.audio.meeting.mode=true
ro.vendor.audio.meeting.mode.type=2
ro.vendor.audio.voice.change.support=true
ro.vendor.audio.voice.change.version=2
ro.vendor.audio.voice.change.youme.support=true
ro.vendor.audio.algorithm.support=Fluence
persist.vendor.audio.call.tx.ns=true
persist.vendor.audio.auto.scenario=true

# Audio — Dolby Atmos (DAX3 — blobs dropped in vendor)
ro.vendor.audio.dolby.dax.support=true
ro.vendor.audio.dolby.dax.version=DAX3_3.12.0.8_r1
ro.vendor.audio.dolby.dax.game.enable=true
ro.vendor.audio.dolby.surround.enable=true
ro.vendor.audio.dolby.vision.support=true
ro.vendor.audio.dolby.spatial.profile=dynamic
persist.vendor.audio.effectimplenter=dolby
vendor.audio.dolby.control.support=true

# Display — Dolby Vision. Gates the SDM composer advertising DOLBY_VISION as a
# supported HDR output type (Display.HdrCapabilities). Without this the panel only
# reports HDR10/HLG/HDR10+ and DV content can't be picked by apps. property_contexts
# already labels this key (vendor_displayfeature_prop); it was just never set.
# dolby_vision.cfg (display DM tuning) is already copied to /odm/etc/surfaceflinger.
ro.vendor.display.dolbyvision.support=true

# Dolby backend selector (A/B switch, reboot-applied):
#   aidl = native DAX3 stack (libhwdapaidl.so + vendor.dolby.dms)  [default]
#   hidl = ported v3_6/sp stack (libhwdap_v3_6.so + dms360/dmssp)
# Gates the dms daemon (device dms-service.rc) and, with DOLBY_RUNTIME_SWITCH,
# the active audio_effects_config.xml.
persist.sys.lunaris.dolby.backend=aidl

# Audio — Game Audio Enhancement (RE: MisAudioGameEffectV2)
ro.vendor.audio.game.mode=true
ro.vendor.audio.game_enhance=true
persist.vendor.audio.fpsop.game.effect=true
persist.vendor.audio.fpsop.game.effect.switch=true
persist.vendor.audio.fpsop.game.effect.speaker=false
persist.vendor.audio.game.effect.version=2

# Audio — Spatial Audio
ro.vendor.audio.spatializer.support.speaker=true
persist.vendor.audio.spatializer.enable=false
vendor.audio.useXiaomiSpatializer=true

# Audio — Speaker Protection & Smart PA (AW882xx / SiA91xx)
# aw.monitor=true → enables Awinic smart PA real-time monitoring
# clean_speaker=true → speaker dust cleaning via high-freq tone
# spkcal.copy.inhal=true → speaker calibration data copy in HAL
ro.vendor.audio.aw.monitor=true
ro.vendor.audio.aw.monitor.v5=true
ro.vendor.audio.clean_speaker=true
ro.vendor.audio.lowpower.pa.para.support=false
vendor.audio.spkcal.copy.inhal=true
persist.vendor.audio.speaker.threshold=120

# Audio — Ultrasound / Proximity (ELUS)
# DISABLED: suspected of triggering Xiaomi's device_orient virtual sensor
# which reports 1-based rotation values (1-4) instead of AOSP's 0-based (0-3),
# causing portrait→landscape off-by-one rotation bug system-wide.
# Re-enable after confirming fix or if ELUS features are needed.
#ro.vendor.audio.elus.proximity.cqrcodesupport=true
#ro.vendor.audio.elus.proximity.fademodule=true
#ro.vendor.audio.elus.proximity.speakermode=true
#ro.vendor.audio.elus.gyrp.disturbance_avoidance=true
#ro.vendor.audio.sixth.monitor=true

