;; new_objects - a collection of types that have been introduced that have no
;;   analogue in older policy. Thus, we do not need to map these types to
;;   previous ones. Add here to pass checkapi/treble compatibility tests.
(type new_objects)
(typeattribute new_objects)
(typeattributeset new_objects
  ( new_objects
    vendor_hal_displayfeature_xiaomi_default
    vendor_hal_displayfeature_xiaomi_service))
(typeattributeset new_objects
  ( new_objects
    activity_structured_service
    gatekeeper_vendor_data_file
    hal_bluetooth_lpp_service
    hal_frp_service
    init_dev_config
    init_dev_config_exec
    native_binder_stats_prop
    native_serial_service
    pbtombstone_exec
    prefetch
    task_continuity_service
    trusty_coverage_prop
    omapi
    omapi_exec
    omapi_service
    serialservice
    serialservice_exec
    sysfs_thunderbolt
    sysfs_typec
    sysfs_usb_pd
    usb_disable_when_locked_prop
    virtualizationservice_data_file
    wallet_prop
    anomaly_detector_service
    uprobestats_service
    dolby_audio_prop
    mithermal_prop
  ))

